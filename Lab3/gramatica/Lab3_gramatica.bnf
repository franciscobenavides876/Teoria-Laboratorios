(* =====================================================================
   Laboratorio 3 - Diseno y Validacion de Gramaticas  (INFO1148)
   Gramatica libre de contexto  G = (V, Sigma, P, S)

   Notacion: BNF, una produccion por linea, numeradas para poder
   referenciarlas en las derivaciones del informe.
   epsilon = produccion vacia (cadena vacia).
   ID, NUM y COMENT son clases lexicas (ver Anexo A del informe).

   P1 - P35  : nucleo del lenguaje solicitado.
   P36 - P43 : extension creativa (Opcion A: condicional).

   El bloque P12-P19 obliga a que una asignacion aritmetica contenga al
   menos un operador (para no solaparse con <asignacion_simple>) SIN
   romper la precedencia: <resto_expresion_aritmetica> exige un '+' o
   '-' de nivel superior y <termino_aritmetico> exige un '*'/'/'/'%'
   cuando la expresion no tiene sumas ni restas.
   ===================================================================== *)

(* ---------- Estructura del programa ---------------------------------- *)
<programa>              ::= Begin Programa <identificador> <lista_instrucciones> End  (* P1  *)

<lista_instrucciones>   ::= <instruccion>                                               (* P2  *)
                          | <instruccion> <lista_instrucciones>                         (* P3  *)
                          | <comentario> <lista_instrucciones>                          (* P4  *)

<instruccion>           ::= <asignacion>                                                (* P5  *)
                          | <salida>                                                    (* P6  *)
                          | <condicional>                                               (* P7  *)

(* ---------- Asignacion ------------------------------------------------ *)
<asignacion>            ::= <asignacion_simple>                                         (* P8  *)
                          | <asignacion_aritmetica>                                     (* P9  *)

<asignacion_simple>     ::= <identificador> = <operando> #                              (* P10 *)

<asignacion_aritmetica> ::= <identificador> = <expresion_aritmetica> #                  (* P11 *)

(* ---------- Expresion aritmetica (con al menos un operador) ----------- *)
<expresion_aritmetica>      ::= <termino> <resto_expresion_aritmetica>                  (* P12 *)
                              | <termino_aritmetico>                                    (* P13 *)

<resto_expresion_aritmetica> ::= + <termino> <resto_expresion>                          (* P14 *)
                               | - <termino> <resto_expresion>                          (* P15 *)

<termino_aritmetico>        ::= <factor> <resto_termino_aritmetico>                     (* P16 *)

<resto_termino_aritmetico>  ::= * <factor> <resto_termino>                              (* P17 *)
                              | / <factor> <resto_termino>                              (* P18 *)
                              | % <factor> <resto_termino>                              (* P19 *)

(* ---------- Expresiones aritmeticas (nucleo) -------------------------- *)
<expresion>             ::= <termino> <resto_expresion>                                 (* P20 *)

<resto_expresion>       ::= + <termino> <resto_expresion>                               (* P21 *)
                          | - <termino> <resto_expresion>                               (* P22 *)
                          | epsilon                                                     (* P23 *)

<termino>               ::= <factor> <resto_termino>                                    (* P24 *)

<resto_termino>         ::= * <factor> <resto_termino>                                  (* P25 *)
                          | / <factor> <resto_termino>                                  (* P26 *)
                          | % <factor> <resto_termino>                                  (* P27 *)
                          | epsilon                                                     (* P28 *)

<factor>                ::= <operando>                                                  (* P29 *)

<operando>              ::= <identificador>                                             (* P30 *)
                          | <numero>                                                    (* P31 *)

(* ---------- Salida ---------------------------------------------------- *)
<salida>                ::= salida <identificador> #                                    (* P32 *)

(* ---------- Nivel lexico (clases de token) --------------------------- *)
<identificador>         ::= ID                                                          (* P33 *)
<numero>                ::= NUM                                                         (* P34 *)
<comentario>            ::= COMENT                                                      (* P35 *)

(* ---------- Extension creativa: condicional (Opcion A) ---------------- *)
<condicional>           ::= si <condicion> entonces <lista_instrucciones> fin_si        (* P36 *)

<condicion>             ::= <expresion> <operador_relacional> <expresion>               (* P37 *)

<operador_relacional>   ::= <                                                           (* P38 *)
                          | >                                                           (* P39 *)
                          | <=                                                          (* P40 *)
                          | >=                                                          (* P41 *)
                          | ==                                                          (* P42 *)
                          | !=                                                          (* P43 *)
